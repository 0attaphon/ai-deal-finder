{
  "manifest_version": 3,
  "name": "AI Deal Finder",
  "version": "0.1.0",
  "description": "Instantly see AI-powered review summaries and price comparisons on Amazon, Shopee, and Lazada.",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/dp/*",
        "*://*.amazon.com/gp/product/*",
        "*://www.amazon.co.uk/dp/*",
        "*://shopee.th/*",
        "*://*.shopee.co.th/*",
        "*://shopee.co.th/*",
        "*://*.shopee.com/*",
        "*://www.lazada.co.th/*",
        "*://*.lazada.co.th/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://shopee.th/*",
    "*://*.shopee.co.th/*",
    "*://*.shopee.com/*",
    "*://www.lazada.co.th/*",
    "*://*.lazada.co.th/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
