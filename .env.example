# ============================================================
# AI Deal Finder — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# OpenAI (server-side only — never expose to browser or extension)
OPENAI_API_KEY=sk-...

# Vercel AI Gateway (optional — if set, routes all AI calls through Vercel AI Gateway instead of OpenAI directly)
# https://vercel.com/docs/ai-gateway
VERCEL_AI_GATEWAY_KEY=vck_...

# Supabase
# New projects (2025+) use "publishable" / "secret" naming in the dashboard
# Old projects still use "anon" / "service_role" — both work until end of 2026
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...            # or SUPABASE_PUBLISHABLE_KEY on new projects
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # or SUPABASE_SECRET_KEY on new projects (server-side only)

# Price Comparison API
# Recommended: PricesAPI (free tier: 1,000 calls/month — enough for beta)
# https://pricesapi.com
# Paid option: FlyByAPIs ($14.99/mo) covers Amazon + Shopee + Lazada
# https://flybyapis.com
PRICE_API_KEY=your_pricesapi_key
PRICE_API_HOST=pricesapi.com

# Affiliate Program IDs
AMAZON_AFFILIATE_TAG=yoursite-20
SHOPEE_AFFILIATE_ID=your_shopee_affiliate_id
LAZADA_AFFILIATE_ID=your_lazada_affiliate_id

# Website URL (used by extension to call API)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
