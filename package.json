{
  "name": "ai-deal-finder",
  "private": true,
  "workspaces": [
    "extension",
    "website"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=website",
    "dev:extension": "npm run dev --workspace=extension",
    "build:website": "npm run build --workspace=website",
    "build:extension": "npm run build --workspace=extension",
    "build": "npm run build:website && npm run build:extension"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
